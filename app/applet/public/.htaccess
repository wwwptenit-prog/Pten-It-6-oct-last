# ==============================================================================
# PTENit & Order Boss — Production .htaccess for cPanel Apache Shared Hosting
# ==============================================================================

# 1. Ensure index.html is loaded first before cPanel default index.php or default.html
DirectoryIndex index.html index.php default.html

# 2. Prevent directory listing (security)
Options -Indexes +FollowSymLinks

# 3. Explicit MIME Types (CRITICAL for modern ES modules on cPanel Apache)
# Prevents "Failed to load module script: Expected a JavaScript module script..."
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/javascript .js
  AddType text/css .css
  AddType image/svg+xml .svg
  AddType application/json .json
  AddType application/manifest+json .webmanifest .json
  AddType font/woff2 .woff2
  AddType font/woff .woff
  AddType font/ttf .ttf
  AddType image/webp .webp
  AddType image/png .png
  AddType image/jpeg .jpg .jpeg
  AddType image/gif .gif
  AddType image/x-icon .ico
</IfModule>

# 4. CORS and Security Headers
<IfModule mod_headers.c>
  # Allow cross-origin asset loading for ES modules, web fonts, and images
  <FilesMatch "\.(js|mjs|css|json|svg|png|jpg|jpeg|gif|webp|ico|woff2|woff|ttf)$">
    Header set Access-Control-Allow-Origin "*"
    Header set Access-Control-Allow-Methods "GET, OPTIONS"
  </FilesMatch>

  # Prevent MIME type sniffing
  Header set X-Content-Type-Options "nosniff"
  Header set X-XSS-Protection "1; mode=block"

  # NEVER cache index.html so visitors always get the latest bundle instantly
  <FilesMatch "^(index\.html|manifest\.json)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
  </FilesMatch>
</IfModule>

# 5. SPA Rewrite Rules (HTML5 History API fallback to index.html)
<IfModule mod_rewrite.c>
  RewriteEngine On

  # If the requested file or folder exists, serve it directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Allow direct access to server API and server data
  RewriteRule ^api/ - [L]
  RewriteRule ^server_data/ - [L]

  # Fallback all other virtual routes and page refreshes to index.html
  RewriteRule . index.html [L]
</IfModule>

# 6. Enable Gzip / Deflate Compression for Super Fast Loading
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/x-javascript application/json application/wasm image/svg+xml
</IfModule>

# 7. Browser Caching for Production Hashed Assets (1 Year)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType application/json "access plus 0 seconds"
</IfModule>
